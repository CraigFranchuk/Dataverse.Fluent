<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The shipped libraries build warning-free; a new warning fails the build. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Dataverse.Fluent' Or '$(MSBuildProjectName)' == 'Dataverse.Fluent.Sales'">
    <IsSourceProject>true</IsSourceProject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- The next release's version. CI appends -ci.<run>; the release workflow requires the tag to match it. -->
    <VersionPrefix>1.0.2</VersionPrefix>
    <Authors>Craig Franchuk</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CraigFranchuk/Dataverse.Fluent</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CraigFranchuk/Dataverse.Fluent</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- assets/icon.png is rendered from assets/icon.svg by assets/render-icon.ps1. -->
  <ItemGroup Condition="'$(IsSourceProject)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
