<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Checks Dataverse.Fluent models against an environment's metadata: columns, types, lookups, navigation properties, entity sets and read-only markers. Run it in an integration test or CI, or from the dataverse-fluent tool. Metadata is read at test time only; the client never needs it.</Description>
    <PackageTags>dataverse;dynamics;crm;fluent;schema;validation;metadata;testing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dataverse.Fluent\Dataverse.Fluent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dataverse.Fluent.Schema.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
