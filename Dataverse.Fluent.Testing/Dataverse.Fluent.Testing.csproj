<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>A fake transport for unit testing code that uses Dataverse.Fluent: route requests to canned responses and errors, answer $batch requests, and assert on the exact requests the real builders send.</Description>
    <PackageTags>dataverse;dynamics;crm;fluent;testing;fake;mock;unit-testing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dataverse.Fluent\Dataverse.Fluent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dataverse.Fluent.Testing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
